# Env file for the `app`/`worker` services in the root docker-compose.yaml
# (the full-stack, production-like compose - NOT the same file as .env,
# which is for the host-based dev flow in README.md). The only real
# difference from .env is the database host: containers reach Postgres via
# the compose service name `db` on its container-internal port 5432, never
# `localhost` (localhost inside a container means the container itself).
#
# POSTGRES_USER/PASSWORD/DB below must match docker/postgres/.env (the `db`
# service's own credentials) exactly. SANDBOX_DB_PASSWORD must match
# whatever you ran the sandbox_runner role migration with (that migration
# still runs from the host against the exposed port - see README.md).

POSTGRES_URL=postgres://kartikey:changeme@db:5432/sql-learn
SANDBOX_DATABASE_URL=postgres://sandbox_runner:changeme@db:5432/sql-learn
SANDBOX_DB_PASSWORD=changeme

# Read by packages/database/src/prisma.ts (app-data CRUD via Prisma) -
# separate from POSTGRES_URL above (used by the raw `pg` admin/sandbox
# pools in the same package, see packages/database/src/index.ts). Same
# physical database, same credentials as POSTGRES_URL - just two different
# client libraries reading two different env var names. DIRECT_URL is only
# read by packages/database/prisma.config.ts, itself only used by the
# `prisma` CLI (generate/migrate) - not at app runtime, since this image's
# Prisma client is generated at build time (see apps/api/Dockerfile) - but
# set it too in case you run `prisma migrate`/`studio` manually inside a
# running container.
DATABASE_URL=postgres://kartikey:changeme@db:5432/sql-learn
DIRECT_URL=postgres://kartikey:changeme@db:5432/sql-learn

TEST_DATABASE_URL=postgres://kartikey:changeme@db:5432/sql-learn-test
TEST_SANDBOX_DATABASE_URL=postgres://sandbox_runner:changeme@db:5432/sql-learn-test

PORT=5000
WORKER_METRICS_PORT=5001
NODE_ENV=production
WORKER_CONCURRENCY=4

CORS_ORIGIN=http://localhost:3000

BETTER_AUTH_URL=http://localhost:5000
BETTER_AUTH_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

CLEANUP_TOKEN=

GOOGLE_GENERATIVE_AI_API_KEY=
