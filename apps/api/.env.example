# Admin/provisioning connection (full privileges within this DB).
POSTGRES_URL=postgres://kartikey:changeme@localhost:5432/sql-learn

# Low-privilege connection used to run student-submitted SQL.
# Role is created by migrations/1700000000002_sandbox_runner_role.js -
# SANDBOX_DB_PASSWORD must match the password used there.
SANDBOX_DATABASE_URL=postgres://sandbox_runner:changeme@localhost:5432/sql-learn
SANDBOX_DB_PASSWORD=changeme

# Used only by `bun run test` - a separate database, never the dev one.
TEST_DATABASE_URL=postgres://kartikey:changeme@localhost:5432/sql-learn-test
TEST_SANDBOX_DATABASE_URL=postgres://sandbox_runner:changeme@localhost:5432/sql-learn-test

PORT=5000
WORKER_METRICS_PORT=5001
NODE_ENV=development

# Number of sandbox jobs (execute_query/evaluate_submission) this worker
# process runs in parallel (pg-boss `localConcurrency`, see src/worker.ts).
# Keep at or below sandboxPool's max connections (10, packages/database) so
# concurrent jobs can't starve each other waiting on a sandbox connection.
WORKER_CONCURRENCY=4

# Exact origin of the frontend (required for cookie-based auth + CORS).
CORS_ORIGIN=http://localhost:3000

# Better Auth (packages/auth/src/auth.ts) - sole source of truth for authentication.
# BETTER_AUTH_URL is this API's own URL (Better Auth's routes are mounted here,
# not on the Next.js app) - used to build OAuth callback URLs.
# Generate BETTER_AUTH_SECRET with: openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:5000
BETTER_AUTH_SECRET=

# Optional - leave both blank to disable that provider's "Continue with ..." button.
# Callback URL to register with the provider: {BETTER_AUTH_URL}/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Callback URL to register with the provider: {BETTER_AUTH_URL}/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Bearer token required on /cleanup/* routes. Must be set - the server
# refuses to start without it.
CLEANUP_TOKEN=

# Optional. Leave unset to run the AI hint engine in "not configured" mode.
GOOGLE_GENERATIVE_AI_API_KEY=
