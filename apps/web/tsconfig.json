{
  "extends": "@sql-learn/config-typescript/nextjs.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@sql-learn/ui/components/*": ["../../packages/ui/src/components/*"],
      "@sql-learn/ui/lib/*": ["../../packages/ui/src/lib/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
