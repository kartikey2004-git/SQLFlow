# Read by src/prisma.ts (app-data CRUD via Prisma) - loaded from this exact
# file regardless of the importing process's own CWD. Point both at the
# same database as apps/api/.env's POSTGRES_URL (same physical DB, just a
# different client library/env var name - see src/prisma.ts's comment).
#
# DATABASE_URL: used at app runtime by the generated Prisma client.
# DIRECT_URL: used only by the `prisma` CLI (generate/migrate/studio, see
# prisma.config.ts) - not read at app runtime.

DATABASE_URL=postgres://kartikey:changeme@localhost:5432/sql-learn
DIRECT_URL=postgres://kartikey:changeme@localhost:5432/sql-learn
